{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "templates/*",
            "use": "@vercel/static"
        },
        {
            "src": "static/*",
            "use": "@vercel/static"
        },
        {
            "src": "images/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/.*",
            "dest": "app.py"
        },
        {
            "src": "/dashboard",
            "dest": "/templates/dashboard.html"
        },
        {
            "src": "/",
            "dest": "/templates/index.html"
        },
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/images/$1"
        },
        {
            "src": "/(.*)",
            "dest": "app.py"
        }
    ]
}