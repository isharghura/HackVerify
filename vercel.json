{
    "builds": [
        {
            "src": "templates/index.html",
            "use": "@vercel/static"
        },
        {
            "src": "api/scrape.py",
            "use": "@vercel/python"
        },
        {
            "src": "api/test.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/api/test",
            "dest": "/api/test.py"
        },
        {
            "src": "/api/scrape",
            "dest": "/api/scrape.py"
        },
        {
            "src": "/templates/(.*)",
            "dest": "/templates/$1"
        },
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/",
            "dest": "/templates/index.html"
        }
    ]
}