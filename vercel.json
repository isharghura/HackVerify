{
    "builds": [
        {
            "src": "static/index.html",
            "use": "@vercel/static"
        },
        {
            "src": "api/scrape.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        }
    ]
}