{
    "builds": [
        {
            "src": "templates/index.html",
            "use": "@vercel/static"
        },
        {
            "src": "templates/dashboard.html",
            "use": "@vercel/static"
        },
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "static/styles.css",
            "use": "@vercel/static"
        },
        {
            "src": "static/dashboard.js",
            "use": "@vercel/static"
        },
        {
            "src": "static/login.js",
            "use": "@vercel/static"
        },
        {
            "src": "images/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/images/(.*)",
            "dest": "/images/$1"
        },
        {
            "src": "/templates/(.*)",
            "dest": "/templates/$1"
        },
        {
            "src": "/",
            "dest": "/templates/index.html"
        },
        {
            "src": "/",
            "dest": "/templates/dashboard.html"
        },
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "app.py"
        },
        {
            "src": "/favicon.ico",
            "dest": "/images/favicon.ico"
        }
    ]
}